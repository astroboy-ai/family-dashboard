# Change these placeholders before starting the stack. Keep the real .env untracked.
POSTGRES_PASSWORD=change-me-strong
S3_ACCESS_KEY=familyos
S3_SECRET_KEY=change-me-strong
S3_BUCKET=familyos-media
S3_API_PORT=8333
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Public origin the browser uses to PUT uploads straight to storage.
# Must be an HTTPS hostname reachable from the internet (e.g. a Cloudflare
# tunnel route like https://media.example.com) or uploads fall back to the
# slower relay endpoint PUT /api/media/{id}/content.
S3_PUBLIC_ENDPOINT=http://localhost:8333
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_TOKEN=replace-with-a-random-64-character-hex-value
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
JWT_SECRET=replace-with-a-random-64-character-hex-value

# Sessions. The access token is short-lived and refreshed silently in the
# background; the refresh token is a rotating, revocable, 30-day cookie.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Household
HOUSEHOLD_NAME=Our Family
HOUSEHOLD_TZ=Asia/Hong_Kong
LOCALE=en

# Shared Docker network with cloudflared + the litellm gateway.
# The value must match the external network created on the host.
DOCKER_NETWORK_NAME=link01

# AI providers.
#
# These are *bootstrap defaults only*. The live values live in
# households.settings['ai'] and are edited from the admin settings page
# (GET/PATCH /api/admin/settings) — changing the embedding model there takes
# effect without a redeploy. Anything set here is only used until a household
# override exists.
#
# Model calls go through the litellm gateway, which holds the upstream keys.
LLM_BASE_URL=http://litellm_proxy:4000
LLM_API_KEY=
EMBEDDING_MODEL=gemini/text-embedding-004
EMBEDDING_DIM=768
OCR_PROVIDER=tesseract
ASR_PROVIDER=faster-whisper
ASR_MODEL=base

# Integrations (optional)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=